# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Newsroom additions
# Environment files: never commit secrets. .env.example documents every setting.
.env.local
.env*.local
# Local SQLite database and model caches (the demo snapshot JSON is committed instead)
data/*.db
data/*.db-*
.cache/
# OS files
.DS_Store
# Uploaded recordings and transcripts (never committed)
data/uploads/
