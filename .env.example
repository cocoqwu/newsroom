# Copy this file to .env.local and fill in the values. .env.local is git-ignored; never commit it.

# Gemini API key for every model call. Create one at https://aistudio.google.com/apikey
# Required for live pipeline runs; demo mode works without it using a saved snapshot.
# Free tier covers the text models below. Pro and image models need a project with billing enabled.
GEMINI_API_KEY=

# Hard cap, in US dollars, on AI image generation across the whole build and demo.
# Every generated image is logged with its list price in docs/image-spend-log.md;
# generation refuses once the cap is reached.
IMAGE_BUDGET_USD=5

# Optional model overrides. Leave unset to use the defaults shown.
# GEMINI_TRIAGE_MODEL=gemini-3.5-flash-lite
# GEMINI_DRAFT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
