# Copy this file to .env.local and fill in the values. .env.local is git-ignored; never commit it.

# Gemini API key for all TEXT model calls (triage, scoring, research, drafting, fact-check).
# Create it at https://aistudio.google.com/apikey inside a project with NO billing account,
# so it stays on the free tier. Required for live pipeline runs; demo mode works without it.
GEMINI_API_KEY=

# Google Cloud API key used ONLY for AI-generated hero images, through Vertex AI.
# Create it in the Cloud project whose billing account holds the credits
# (APIs & Services -> Credentials -> Create credentials -> API key) and enable the Vertex AI API
# in that project. Optional: without it, the Draft screen shows the three SVG headers only.
GOOGLE_CLOUD_API_KEY=

# Project ID of that same Google Cloud project (e.g. my-project-123456). Optional; used when
# the key must be sent with an explicit project path.
GOOGLE_CLOUD_PROJECT=

# Hard cap, in US dollars, on image generation spend across the whole build and demo.
# Every generated image is logged with its price; generation refuses once the cap is reached.
IMAGE_BUDGET_USD=5
