{
  "name": "newsroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "pipeline:collect": "tsx scripts/run-pipeline.ts --only collect",
    "demo:load": "tsx scripts/load-demo.ts",
    "demo:save": "tsx scripts/save-demo.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "check:keys": "node scripts/check-keys.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "NEWSROOM_MODE=demo next dev --port 3100",
    "demo:start": "NEWSROOM_MODE=demo next start --port 3100",
    "demo:seed-event": "tsx scripts/seed-sample-event.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.30.0",
    "@huggingface/transformers": "^4.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss-parser": "^3.13.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "@google/genai@2.30.0": true
  }
}
